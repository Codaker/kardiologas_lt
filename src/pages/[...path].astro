---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Slider from '../components/Slider.astro';
import VideoFaq from '../components/VideoFaq.astro';
import Sidebar from '../components/Sidebar.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { withBase } from '../lib/urls';
import { canonicalPath } from '../lib/seo.mjs';
import Icon from '../components/Icon.astro';
import ArticleImage from '../components/ArticleImage.astro';
import { Image, getImage } from 'astro:assets';
export async function getStaticPaths() {
  return (await getCollection('pages')).map((page) => ({
    params: {
      path:
        page.data.path === '/'
          ? undefined
          : page.data.path.replace(/^\/|\/$/g, ''),
    },
    props: { page },
  }));
}
interface Props {
  page: CollectionEntry<'pages'>;
}
const { page } = Astro.props;
const { Content } = await render(page);
const site = (await getEntry('settings', 'site'))!.data;
const pageBackground = ['about', 'listing', 'contact'].includes(page.data.type)
  ? await getImage({ src: site.pageBackground, format: 'webp' })
  : undefined;
const pages = await getCollection('pages');
const features = await Promise.all(
  (await getCollection('features'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (e) => ({ ...e, ...(await render(e)) })),
);
const listed = page.data.entries
  .map((path) => pages.find((e) => e.data.path === path))
  .filter((e): e is CollectionEntry<'pages'> => !!e);
const related = page.data.related.map((path) => {
  const entry = pages.find((entry) => entry.data.path === path);
  if (!entry) throw new Error(`Unknown related page: ${path}`);
  return entry;
});
const homeArticles = [
  '/apie-sirdies-stimuliatoriu/',
  '/kaip-pasiruosti-pries-konsultacija/',
  '/apie-koronarografija-vainikiniu-arteriju-angiografija-sirdies-kraujagysliu-zondavimas/',
].map((path) => pages.find((p) => p.data.path === path)!);
const patientListing =
  page.data.type === 'listing' &&
  page.data.path.startsWith('/informacija-pacient');
const listingRoot = page.data.path.split('/page/')[0].replace(/\/$/, '') + '/';
const parent =
  page.data.type === 'article'
    ? site.services.some((service) => service.path === page.data.path)
      ? { title: 'Paslaugos ir tyrimai', path: '/paslaugos-ir-tyrimai/' }
      : { title: 'Informacija pacientams', path: '/informacija-pacientams/' }
    : page.data.pageNumber > 1
      ? { title: 'Informacija pacientams', path: canonicalPath(listingRoot) }
      : undefined;
---

<SiteLayout
  title={page.data.title}
  seoTitle={page.data.seoTitle}
  pageType={page.data.type}
  parent={parent}
  description={page.data.description}
  path={page.data.path}
>
  {page.data.type === 'home' && (
    <>
      <Slider />
      <section class="feature-band">
        <div class="container feature-grid">
          {features.map((feature) => (
            <div class="feature">
              <Icon name={feature.data.icon} />
              <h2>{feature.data.title}</h2>
              <div>
                <feature.Content />
              </div>
            </div>
          ))}
        </div>
      </section>
      <VideoFaq />
      <section class="container home-articles">
        <h2 class="section-heading">
          {site.patientTitle}
          <svg aria-hidden="true" viewBox="0 0 86 24">
            <path d="M0 12h31l4-6 4 13 5-18 5 22 4-13 4 2h29" />
          </svg>
        </h2>
        <div class="article-cards">
          {homeArticles.map((article) => (
            <article>
              <h3>
                <a href={withBase(article.data.path)}>{article.data.title}</a>
              </h3>
              <p>{article.data.excerpt}</p>
              <a
                class="button small read-more"
                href={withBase(article.data.path)}
                aria-label={`Skaityti daugiau: ${article.data.title}`}
              >
                Skaityti daugiau
              </a>
            </article>
          ))}
        </div>
      </section>
    </>
  )}
  {page.data.type === 'article' && (
    <div class="container article-layout">
      <Sidebar path={page.data.path} />
      <article class="article-body prose">
        <h1>{page.data.title}</h1>
        <ArticleImage illustration={page.data.illustration} />
        <Content />
        {related.length > 0 && (
          <section
            class="related-content"
            aria-labelledby="susijusi-informacija"
          >
            <h2 id="susijusi-informacija">Susijusi informacija</h2>
            <ul>
              {related.map((entry) => (
                <li>
                  <a href={withBase(canonicalPath(entry.data.path))}>
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    </div>
  )}
  {page.data.type === 'about' && (
    <>
      <div
        class="page-banner"
        style={`background-image: url("${pageBackground!.src}")`}
      >
        <h1>{page.data.title}</h1>
      </div>
      <section class="container about-layout">
        <article class="prose">
          <Content />
        </article>
        {page.data.illustration && (
          <Image
            class="about-image"
            src={page.data.illustration.src}
            alt={page.data.illustration.alt}
            widths={[400, 800]}
            sizes="(max-width: 700px) calc(100vw - 36px), 55vw"
            loading="lazy"
          />
        )}
      </section>
      <VideoFaq video="https://www.youtube.com/embed/vbpKD-mrILo" />
    </>
  )}
  {page.data.type === 'contact' && (
    <>
      <div
        class="page-banner"
        style={`background-image: url("${pageBackground!.src}")`}
      >
        <h1>{page.data.title}</h1>
        <p>Registruokitės telefonu arba internetu</p>
      </div>
      <ContactDetails>
        <Content />
      </ContactDetails>
      <section
        class="container contact-map-section"
        id="kontaktai-zemelapis"
        aria-labelledby="zemelapio-antraste"
      >
        <h2 id="zemelapio-antraste">Kaip mus rasti</h2>
        <p>{site.address}, Lietuva</p>
        <iframe
          class="contact-map"
          src={site.map}
          title="Pulsas – Sodų gatvė 56, Kaunas"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </section>
      <ContactForm />
    </>
  )}
  {page.data.type === 'listing' && (
    <>
      <div
        class="page-banner"
        style={`background-image: url("${pageBackground!.src}")`}
      >
        <h1>{page.data.title}</h1>
      </div>
      <div
        class:list={[
          'container listing-layout',
          { 'patient-listing': patientListing },
        ]}
      >
        {patientListing ? (
          <aside class="sidebar">
            <h2>Naudinga pacientams</h2>
            <ul>
              {[
                '/apie-sirdies-ligas/',
                ...homeArticles.map((p) => p.data.path),
                '/stento-implantavimas/',
              ].map((path) => {
                const post = pages.find((p) => p.data.path === path);
                return (
                  post && (
                    <li>
                      <a href={withBase(path)}>{post.data.title}</a>
                    </li>
                  )
                );
              })}
            </ul>
            <h2>Kategorijos</h2>
            <ul>
              <li>
                <a href={withBase('/category/informacija-pacientui/')}>
                  Informacija pacientams
                </a>
              </li>
              <li>
                <a href={withBase('/paslaugos-ir-tyrimai/')}>
                  Paslaugos ir tyrimai
                </a>
              </li>
              <li>
                <a href={withBase('/category/uncategorized/')}>Širdies ligos</a>
              </li>
            </ul>
          </aside>
        ) : (
          <Sidebar path={page.data.path} />
        )}
        <div class="post-list">
          <p class="listing-intro">{page.data.description}</p>
          {listed.map((entry) => (
            <article class="prose">
              <h2>
                <a href={withBase(entry.data.path)}>{entry.data.title}</a>
              </h2>
              {patientListing && (
                <ArticleImage illustration={entry.data.illustration} />
              )}
              <p>{entry.data.excerpt}</p>
              <a
                class="button small read-more"
                href={withBase(entry.data.path)}
                aria-label={`Skaityti daugiau: ${entry.data.title}`}
              >
                Skaityti daugiau
              </a>
            </article>
          ))}
          {patientListing && (
            <nav class="pagination" aria-label="Puslapiai">
              <a
                href={withBase(canonicalPath(listingRoot))}
                aria-current={page.data.pageNumber === 1 ? 'page' : undefined}
              >
                1
              </a>
              <a
                href={withBase(canonicalPath(listingRoot + 'page/2/'))}
                aria-current={page.data.pageNumber === 2 ? 'page' : undefined}
              >
                2
              </a>
            </nav>
          )}
        </div>
      </div>
    </>
  )}
</SiteLayout>
