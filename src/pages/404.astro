---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/urls';
---

<SiteLayout
  title="Puslapis nerastas"
  description="Puslapis nerastas. Grįžkite į kabineto „Pulsas“ pradžią, peržiūrėkite kardiologijos paslaugas arba susisiekite dėl registracijos."
  path="/404/"
  noindex
>
  <section class="container not-found">
    <p class="blue">404</p>
    <h1>Puslapis nerastas</h1>
    <p>Patikrinkite adresą arba grįžkite į pradžią.</p>
    <a class="button" href={withBase('/')}>
      Pradžia
    </a>
  </section>
</SiteLayout>
