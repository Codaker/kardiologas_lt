---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
const { video } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const faq = await Promise.all(
  (await getCollection('faq'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ ...entry, ...(await render(entry)) })),
);
---

<section class="container video-faq">
  <div>
    <h2>{site.videoTitle}</h2>
    <button
      class="video-launch"
      type="button"
      data-video={video || site.video}
      aria-label="Žiūrėti vaizdo įrašą: Kodėl verta konsultuotis PULSE"
    >
      <Image
        src={site.videoPoster}
        widths={[360, 690, 960]}
        sizes="(max-width: 800px) calc(100vw - 40px), 45vw"
        loading="lazy"
        alt="Kodėl verta konsultuotis PULSE"
      />
      <span class="play-icon" aria-hidden="true">
        ▶
      </span>
    </button>
    <noscript>
      <style>
        .video-launch {
          display: none;
        }
      </style>
      <a href={video || site.video} target="_blank" rel="noopener noreferrer">
        Žiūrėti vaizdo įrašą: {site.videoTitle} (naujame skirtuke)
      </a>
    </noscript>
  </div>
  <div class="faq">
    <h2>{site.faqTitle}</h2>
    {faq.map((entry, i) => (
      <details name="questions" open={i === 0}>
        <summary>{entry.data.title}</summary>
        <div class="faq-answer">
          <entry.Content />
        </div>
      </details>
    ))}
  </div>
</section>
<dialog class="video-dialog" aria-label="Vaizdo įrašas">
  <button class="dialog-close" aria-label="Uždaryti vaizdo įrašą">
    ×
  </button>
  <div class="video-container"></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog')!;
  const container = dialog.querySelector<HTMLElement>('.video-container')!;
  document
    .querySelectorAll<HTMLButtonElement>('[data-video]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = button.dataset.video!;
        iframe.title = 'Kodėl verta konsultuotis PULSE';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        container.replaceChildren(iframe);
        dialog.showModal();
      }),
    );
  dialog
    .querySelector('.dialog-close')
    ?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => container.replaceChildren());
</script>
