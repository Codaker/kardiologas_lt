---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/urls';
const pages = await getCollection('pages');
const aliases = Object.fromEntries(
  pages.flatMap((page) =>
    page.data.queryAliases.map((query) => [query, withBase(page.data.path)]),
  ),
);
const searchPath = withBase('/paieska/');
---

<script define:vars={{ aliases, searchPath }}>
  const query = new URLSearchParams(location.search);
  const search = query.get('s');
  const target = Object.entries(aliases).find(([alias]) =>
    [...new URLSearchParams(alias)].every(
      ([key, value]) => query.get(key) === value,
    ),
  )?.[1];
  if (search) location.replace(searchPath + '?s=' + encodeURIComponent(search));
  else if (target && target !== location.pathname)
    location.replace(target + location.hash);
</script>
