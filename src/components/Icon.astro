---
interface Props {
  name:
    'phone' | 'mail' | 'location' | 'calendar' | 'handshake' | 'chevron-down';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  'chevron-down': 'm6 9 6 6 6-6',
  phone:
    'M6.5 3h3l1.5 5-2.5 1.5a13 13 0 0 0 6 6L16 13l5 1.5v3A3.5 3.5 0 0 1 17.5 21C9.5 20.5 3.5 14.5 3 6.5A3.5 3.5 0 0 1 6.5 3Z',
  mail: 'M3 5h18v14H3V5Zm0 1 9 7 9-7',
  location:
    'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  calendar: 'M4 5h16v16H4V5ZM8 3v4m8-4v4M4 10h16M8 14h2m4 0h2m-8 3h2m4 0h2',
  handshake:
    'm2 7 4-3 4 2 4-2 8 4-4 10-3 3-4-1-5-4-4-9Zm8-1-3 5 2 1 3-3 7 6m-9 1 4 4m-1-7 4 5M2 7l4 2m12-3 4 2',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
