---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/urls';
import { canonicalPath } from '../lib/seo.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StructuredData from '../components/StructuredData.astro';
import '@fontsource/rubik/latin-ext-400.css';
import '@fontsource/rubik/latin-400.css';
import '@fontsource/rubik/latin-ext-500.css';
import '@fontsource/rubik/latin-500.css';
import '@fontsource/rubik/latin-ext-700.css';
import '@fontsource/rubik/latin-700.css';
import '@fontsource/rubik/latin-ext-300.css';
import '@fontsource/rubik/latin-300.css';
import '@fontsource/open-sans/latin-ext-400.css';
import '@fontsource/open-sans/latin-400.css';
import '../styles/global.css';
interface Props {
  title: string;
  seoTitle?: string;
  pageType?: string;
  parent?: { title: string; path: string };
  description?: string;
  path?: string;
  noindex?: boolean;
}
const {
  title,
  seoTitle = title,
  pageType = 'page',
  parent,
  description: pageDescription,
  path = '/',
  noindex = false,
} = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const description = pageDescription || site.description;
const fullTitle = `${seoTitle} | Pulsas`;
const preferredPath = canonicalPath(path);
const canonical = new URL(withBase(preferredPath), Astro.site);
const indexableSite = Astro.site?.origin === 'https://kardiologas.lt';
const robots =
  indexableSite && !noindex
    ? 'index,follow,max-image-preview:large'
    : 'noindex,follow';
const social = await getImage({
  src: site.socialImage,
  width: Math.min(1200, site.socialImage.width),
  format: 'jpg',
});
const socialUrl = new URL(social.src, Astro.site).href;
const breadcrumbs =
  path === '/'
    ? []
    : [
        { title: 'Pradžia', path: '/' },
        ...(parent ? [parent] : []),
        { title, path: preferredPath },
      ];
---

<!doctype html>
<html lang="lt" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {indexableSite && (
      <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    )}
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:alt" content={site.socialImageAlt} />
    <meta property="og:image:width" content={String(social.attributes.width)} />
    <meta
      property="og:image:height"
      content={String(social.attributes.height)}
    />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialUrl} />
    <meta name="twitter:image:alt" content={site.socialImageAlt} />
    <StructuredData
      site={site}
      title={seoTitle}
      description={description}
      canonical={canonical}
      pageType={pageType}
      image={socialUrl}
      breadcrumbs={breadcrumbs}
    />
    <link rel="icon" href={site.logo.src} />
    <meta name="theme-color" content="#2e9ce6" />
  </head>
  <body>
    <Header path={path} />
    <main id="main">
      {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
